<?xml version="1.0" encoding="UTF-8"?>
<!--MCBeans Constant -->
<mcframe>
	<FS>
		<popup>
			<table>
				<POPUP_EXCEL_IN>
					<visible>
						<r0>
							<excld>FSBFP0150,FSBCP0180,FSBCP0190,FSBDP0010,FSBFP0080,FSBFP0220,FSBGP0030</excld>
						</r0>
					</visible>
				</POPUP_EXCEL_IN>
				<POPUP_CSV_IN>
					<visible>
						<r0>
							<excld>FSBFP0150,FSBCP0180,FSBCP0190,FSBDP0010,FSBFP0080,FSBFP0220,FSBGP0030</excld>
						</r0>
					</visible>
				</POPUP_CSV_IN>
			</table>
		</popup>
		<FSBAP0050>
			<icon>
				<adjustSize>true</adjustSize>
			</icon>
			<button>
				<fg>0,0,0</fg>
				<bg>255,255,255</bg>
				<mode>
					<REQUIRED>
						<fg>{FS.FSBAP0050.button.fg}</fg>
						<bg>{FS.FSBAP0050.button.bg}</bg>
					</REQUIRED>
					<ENABLE>
						<fg>{FS.FSBAP0050.button.fg}</fg>
						<bg>{FS.FSBAP0050.button.bg}</bg>
					</ENABLE>
					<DISABLE>
						<fg>{fg}</fg>
						<bg>{bg}</bg>
					</DISABLE>
				</mode>
			</button>
		</FSBAP0050>
		<FSBAP0060>
			<icon>
				<adjustSize>true</adjustSize>
			</icon>
			<button>
				<fg>0,0,0</fg>
				<bg>255,255,255</bg>
				<mode>
					<REQUIRED>
						<fg>{FS.FSBAP0050.button.fg}</fg>
						<bg>{FS.FSBAP0050.button.bg}</bg>
					</REQUIRED>
					<ENABLE>
						<fg>{FS.FSBAP0050.button.fg}</fg>
						<bg>{FS.FSBAP0050.button.bg}</bg>
					</ENABLE>
					<DISABLE>
						<fg>{fg}</fg>
						<bg>{bg}</bg>
					</DISABLE>
				</mode>
			</button>
		</FSBAP0060>
		<FSBAP0130>
			<icon>
				<adjustSize>false</adjustSize>
			</icon>
			<textarea>
				<fg>{rootpanel.fg}</fg>
				<bg>{rootpanel.bg}</bg>
				<mode>
					<READ_ONLY>
						<fg>{FS.FSBAP0130.textarea.fg}</fg>
						<bg>{FS.FSBAP0130.textarea.bg}</bg>
					</READ_ONLY>
				</mode>
			</textarea>
		</FSBAP0130>
		<FSBAP0130><statusbar>false</statusbar></FSBAP0130>
		<FSBAP0230><statusbar>false</statusbar></FSBAP0230>
		<FSBAP0290>
			<icon>
				<SETPARAM>/mcframe/clientCore/icon/check.png</SETPARAM>
			</icon>
		</FSBAP0290>

		<FSBCP0020>
			<popup>
				<menubutton>
					<BM_ADD>
						<visible>true</visible>
						<fg>255,255,0</fg>
						<bg>0,255,255</bg>
					</BM_ADD>
					<BM_DEL>
						<visible>true</visible>
						<fg>{popup.fg}</fg>
						<bg>{popup.bg}</bg>
					</BM_DEL>
				</menubutton>
				<menutree>
					<BM_ADD>
						<visible>true</visible>
						<fg>{popup.fg}</fg>
						<bg>{popup.bg}</bg>
					</BM_ADD>
					<BM_DEL>
						<visible>true</visible>
						<fg>{popup.fg}</fg>
						<bg>{popup.bg}</bg>
					</BM_DEL>
				</menutree>
			</popup>
		</FSBCP0020>
		<FSBCP0030>
			<!-- 起動部分(右)のボタン -->
			<ib>
				<!-- 1列の最大個数 -->
				<buttonRow>15</buttonRow>
				<!-- 幅 -->
				<width>200</width>
				<!-- 高さ -->
				<height>21</height>
				<!-- フォント -->
				<!-- <font>dialog,PLAIN,13</font> -->
				<!-- 前景色 -->
				<!-- <fg>0,0,0</fg> -->
				<!-- 背景色 -->
				<!-- <bg>102,204,102</bg> -->
				<!-- フォーカスがある場合の前景色 -->
				<!-- <ffg>255,255,255</ffg> -->
				<!-- フォーカスがある場合の背景色 -->
				<!-- <fbg>0,128,0</fbg> -->
			</ib>
		</FSBCP0030>

		<FSBEP0080>
			<color>
				<JarTable>
					<product>
						<odd>{color.LIGHTCYAN}</odd>
						<even>{color.LIGHTBLUE}</even>
					</product>
				</JarTable>
			</color>
		</FSBEP0080>
	</FS>
	<drag_and_drop>
		<drop_setting>
			<FS>
				<FSBAP0220>
					<Image>
						<image>Btn.select,,</image>
					</Image>
				</FSBAP0220>
				<FSBBP0010>
					<Psnl>
						<imp>Psnl.imp</imp>
					</Psnl>
				</FSBBP0010>
				<FSBFP0250>
					<Psnl>
						<imp>Psnl.imp</imp>
					</Psnl>
				</FSBFP0250>
			</FS>
		</drop_setting>
	</drag_and_drop>
</mcframe>
