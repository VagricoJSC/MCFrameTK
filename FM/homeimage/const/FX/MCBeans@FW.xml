<?xml version="1.0" encoding="UTF-8"?>
<!--MCBeans Constant-->
<mcframe>
	<!-- ポップアップメニュー -->
	<popup>
		<rootpanel>
			<!-- 検索条件 -->
			<POPUP_SRCH_CND>
				<order>3</order>
				<visible>true</visible>
				<fg>{popup.fg}</fg>
				<bg>{popup.bg}</bg>
			</POPUP_SRCH_CND>
			<!-- 検索条件設定 -->
			<POPUP_SRCH_CND_PANEL>
				<order>1</order>
				<visible>true</visible>
				<fg>{popup.fg}</fg>
				<bg>{popup.bg}</bg>
			</POPUP_SRCH_CND_PANEL>
			<!-- 検索条件を初期状態に戻す -->
			<POPUP_SRCH_CND_INIT_CND>
				<order>2</order>
				<visible>{popup.rootpanel.POPUP_SRCH_CND_PANEL.visible}</visible>
				<fg>{popup.rootpanel.POPUP_SRCH_CND_PANEL.fg}</fg>
				<bg>{popup.rootpanel.POPUP_SRCH_CND_PANEL.bg}</bg>
			</POPUP_SRCH_CND_INIT_CND>
			<!-- 検索条件設定のセパレータ -->
			<POPUP_SRCH_CND_SEPARATOR>
				<order>3</order>
				<visible>true</visible>
			</POPUP_SRCH_CND_SEPARATOR>
			<!-- ユーザ情報一括適用 -->
			<POPUP_APPLY_USER_INFO>
				<order>4</order>
				<visible>true</visible>
				<fg>{popup.fg}</fg>
				<bg>{popup.bg}</bg>
			</POPUP_APPLY_USER_INFO>
			<!-- 画面メモ -->
			<POPUP_MEMO>
				<order>5</order>
			</POPUP_MEMO>
			<!-- ブックマークへ追加 -->
			<POPUP_BOOKMARK>
				<order>6</order>
			</POPUP_BOOKMARK>
			<!-- 縦表示 -->
			<POPUP_VERTICAL_VIEW>
				<order>7</order>
				<visible>true</visible>
				<fg>{popup.fg}</fg>
				<bg>{popup.bg}</bg>
			</POPUP_VERTICAL_VIEW>
			<!-- 画面のURLをコピー -->
			<POPUP_SCREEN_URL>
				<order>8</order>
				<visible>true</visible>
				<fg>{popup.fg}</fg>
				<bg>{popup.bg}</bg>
			</POPUP_SCREEN_URL>
			<!-- レイアウトデバッグ -->
			<POPUP_LAYOUT_DEBUG>
				<order>9</order>
				<visible>true</visible>
				<fg>{popup.fg}</fg>
				<bg>{popup.bg}</bg>
			</POPUP_LAYOUT_DEBUG>
			<!-- 検索枠展開 --> >
			<POPUP_EXPAND>
				<order>1</order>
					<visible>true</visible>
					<fg>{popup.fg}</fg>
					<bg>{popup.bg}</bg>
			</POPUP_EXPAND>
			<POPUP_EXPAND_DEFAULT>
				<order>1</order>
				<visible>true</visible>
				<fg>{popup.fg}</fg>
				<bg>{popup.bg}</bg>
			</POPUP_EXPAND_DEFAULT>
			<POPUP_EXPAND_NOT_CLOSE>
				<order>2</order>
				<visible>true</visible>
				<fg>{popup.fg}</fg>
				<bg>{popup.bg}</bg>
			</POPUP_EXPAND_NOT_CLOSE>
		</rootpanel>
		<table>
			<!-- セル検索 -->
			<POPUP_FIND_CELL>
				<order>10</order>
				<visible>true</visible>
				<fg>{popup.fg}</fg>
				<bg>{popup.bg}</bg>
			</POPUP_FIND_CELL>
			<!-- 縦表示 -->
			<POPUP_VERTICAL_VIEW>
				<order>11</order>
				<visible>true</visible>
				<fg>{popup.fg}</fg>
				<bg>{popup.bg}</bg>
			</POPUP_VERTICAL_VIEW>
		</table>
	</popup>
</mcframe>
