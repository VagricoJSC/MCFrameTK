<?xml version="1.0" encoding="UTF-8"?>
<!--MCBeans Constant-->
<mcframe>

	<font>Meiryo UI,PLAIN,11</font>
	<font_bold>Meiryo UI,BOLD,11</font_bold>
	<multiline_font>Meiryo UI,PLAIN,10</multiline_font>
	
	<text_margin_top>-3</text_margin_top>
	<text_margin_bottom>-1</text_margin_bottom>
	<label>
		<multiline_font>{multiline_font}</multiline_font>
		<text_margin_top>{text_margin_top}</text_margin_top>
		<text_margin_bottom>{text_margin_bottom}</text_margin_bottom>
	</label>
	<check>
		<multiline_font>{multiline_font}</multiline_font>
		<text_margin_top>{text_margin_top}</text_margin_top>
		<text_margin_bottom>{text_margin_bottom}</text_margin_bottom>
	</check>
	<radio>
		<multiline_font>{multiline_font}</multiline_font>
		<text_margin_top>{text_margin_top}</text_margin_top>
		<text_margin_bottom>{text_margin_bottom}</text_margin_bottom>
	</radio>
	<button>
		<multiline_font>{multiline_font}</multiline_font>
		<text_margin_top>{text_margin_top}</text_margin_top>
		<text_margin_bottom>{text_margin_bottom}</text_margin_bottom>
	</button>
	<SCR_COMP><ABS_BUTTON><B_LAYOUT>true</B_LAYOUT></ABS_BUTTON></SCR_COMP>
	<message_name>
		<remove_line_feed_code>true</remove_line_feed_code>
	</message_name>
	<table><header>
		<priorlabelwidth>true</priorlabelwidth>
		<remove_line_feed_code>true</remove_line_feed_code>
	</header></table>
</mcframe>