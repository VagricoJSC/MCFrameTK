<?xml version="1.0" encoding="UTF-8"?>
<!--MCFormat Constant-->
<mcframe>
	<date>
		<YMD>
			<output>
				<pattern>yyyy-MM-dd</pattern>
			</output>
		</YMD>
		<YM>
			<output>
				<pattern>yyyy-MM</pattern>
			</output>
		</YM>
		<MD>
			<output>
				<pattern>MM-dd</pattern>
			</output>
		</MD>
		<YMDHM>
			<output>
				<pattern>yyyy-MM-dd HH:mm</pattern>
			</output>
		</YMDHM>
		<YMDHMS>
			<output>
				<pattern>yyyy-MM-dd HH:mm:ss</pattern>
			</output>
		</YMDHMS>
		<YMDHMSS>
			<output>
				<pattern>yyyy-MM-dd HH:mm:ss.SSS</pattern>
			</output>
		</YMDHMSS>
		<Y2MD>
			<output>
				<pattern>yy-MM-dd</pattern>
			</output>
		</Y2MD>
		<Y2M>
			<output>
				<pattern>yy-MM</pattern>
			</output>
		</Y2M>
		<HM>
			<output>
				<pattern>HH:mm</pattern>
			</output>
		</HM>
		<Y2MDHM>
			<output>
				<pattern>yy-MM-dd HH:mm</pattern>
			</output>
		</Y2MDHM>
		<Y2MDHMS>
			<output>
				<pattern>yy-MM-dd HH:mm:ss</pattern>
			</output>
		</Y2MDHMS>
		<Y2MDHMSS>
			<output>
				<pattern>yy-MM-dd HH:mm:ss.SSS</pattern>
			</output>
		</Y2MDHMSS>
		<YMDE>
			<output>
				<pattern>yyyy-MM-dd (E)</pattern>
			</output>
		</YMDE>
		<Y2MDE>
			<output>
				<pattern>yy-MM-dd (E)</pattern>
			</output>
		</Y2MDE>
		<Y>
			<output>
				<pattern>yyyy</pattern>
			</output>
		</Y>
	</date>
	<excel>
		<EEE>aaaa</EEE>
		<EEEE>aaaa</EEEE>
		<lcid>804</lcid>
	</excel>
</mcframe>
