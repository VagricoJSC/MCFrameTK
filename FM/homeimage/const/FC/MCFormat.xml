<?xml version="1.0" encoding="UTF-8"?>
<!--MCFormat Constant -->
<mcframe>
	<!-- 日付のフォーマット -->
	<date>
		<YMD>
			<output>
				<pattern>yyyy/MM/dd</pattern>
			</output>
		</YMD>
		<YM>
			<output>
				<pattern>yyyy/MM</pattern>
			</output>
		</YM>
		<MD>
			<output>
				<pattern>MM/dd</pattern>
			</output>
		</MD>
		<YMDHM>
			<output>
				<pattern>yyyy/MM/dd HH:mm</pattern>
			</output>
		</YMDHM>
		<YMDHMS>
			<output>
				<pattern>yyyy/MM/dd HH:mm:ss</pattern>
			</output>
		</YMDHMS>
		<YMDHMSS>
			<output>
				<pattern>yyyy/MM/dd HH:mm:ss.SSS</pattern>
			</output>
		</YMDHMSS>
		<Y2MD>
			<output>
				<pattern>yy/MM/dd</pattern>
			</output>
		</Y2MD>
		<Y2M>
			<output>
				<pattern>yy/MM</pattern>
			</output>
		</Y2M>
		<HM>
			<output>
				<pattern>HH:mm</pattern>
			</output>
		</HM>
		<Y2MDHM>
			<output>
				<pattern>yy/MM/dd HH:mm</pattern>
			</output>
		</Y2MDHM>
		<Y2MDHMS>
			<output>
				<pattern>yy/MM/dd HH:mm:ss</pattern>
			</output>
		</Y2MDHMS>
		<Y2MDHMSS>
			<output>
				<pattern>yy/MM/dd HH:mm:ss.SSS</pattern>
			</output>
		</Y2MDHMSS>
		<YMDE>
			<output>
				<pattern>yyyy/MM/dd (E)</pattern>
			</output>
		</YMDE>
		<Y2MDE>
			<output>
				<pattern>yy/MM/dd (E)</pattern>
			</output>
		</Y2MDE>
		<Y>
			<output>
				<pattern>yyyy</pattern>
			</output>
		</Y>
	</date>
	<!-- 数値フォーマット -->
	<!-- 数値フォーマットの色設定はモードよりも優先される -->
	<!-- 色設定は準備中 -->
	<number>
		<COMMA>
			<input>
				<pattern>#####0.##</pattern>
			</input>
			<output>
				<pattern>###,##0.##</pattern>
			</output>
			<zero>CUT</zero>
			<positive>
				<fg></fg>
			</positive>
			<negative>
				<fg>255,0,0</fg>
			</negative>
		</COMMA>
		<NONE>
			<input>
				<pattern>#####0.##</pattern>
			</input>
			<output>
				<pattern>#####0.##</pattern>
			</output>
			<zero>CUT</zero>
			<positive>
				<fg></fg>
			</positive>
			<negative>
				<fg>255,0,0</fg>
			</negative>
		</NONE>
		<RPT_COMMA>
			<input>
				<pattern>#####0.##</pattern>
			</input>
			<output>
				<pattern>###,##0.##</pattern>
			</output>
			<zero>PADDING</zero>
			<positive>
				<fg>0,0,0</fg>
			</positive>
			<negative>
				<fg>255,0,0</fg>
			</negative>
		</RPT_COMMA>
		<RPT_NONE>
			<input>
				<pattern>#####0.##</pattern>
			</input>
			<output>
				<pattern>#####0.##</pattern>
			</output>
			<zero>PADDING</zero>
			<positive>
				<fg>0,0,0</fg>
			</positive>
			<negative>
				<fg>255,0,0</fg>
			</negative>
		</RPT_NONE>
	</number>
	<excel>
		<EEE>aaa</EEE>
		<EEEE>aaaa</EEEE>
		<lcid>411</lcid>
	</excel>
</mcframe>
