<?xml version="1.0" encoding="UTF-8"?>
<!--MCAppServer Constant-->
<mcframe>
	<report>
		<Excel>
			<usePassword>false</usePassword>
		</Excel>
	</report>
	<database>
		<sessionkilled>
			<noerrorlog>true</noerrorlog>
			<immediate>false</immediate>
		</sessionkilled>
	</database>
	<gadget>
		<class>
			<!-- ユーザガジェット -->
			<FCBAL0040>
				<key>FCBAL0040</key>
				<module>FC</module>
				<visible>false</visible><!-- 一覧非表示 -->
				<property>
					<type>mining</type>
					<size>2,3</size><!-- 登録時に設定？ -->
					<searchonce>false</searchonce>
					<charttype>line</charttype>
				</property>
			</FCBAL0040>
		</class>
	</gadget>
	<serversignal>
		<valid>true</valid>
		<cleanupdays>3</cleanupdays>
		<monitoring><interval>3000</interval></monitoring>
		<status><checkcnt>10</checkcnt></status>
		<interrupt><mode>2</mode></interrupt>
		
		<autokill>
			<valid>false</valid>
			<period>5</period>
		</autokill>
		
	</serversignal>
</mcframe>
