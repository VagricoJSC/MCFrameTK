<?xml version="1.0" encoding="UTF-8"?>
<!--MCFormat Constant -->
<mcframe>
	<date>
		<YMD>
			<output>
				<pattern>MM-dd-yyyy</pattern>
			</output>
		</YMD>
		<YM>
			<output>
				<pattern>MM-yyyy</pattern>
			</output>
		</YM>
		<MD>
			<output>
				<pattern>MM-dd</pattern>
			</output>
		</MD>
		<YMDHM>
			<output>
				<pattern>MM-dd-yyyy HH:mm</pattern>
			</output>
		</YMDHM>
		<YMDHMS>
			<output>
				<pattern>MM-dd-yyyy HH:mm:ss</pattern>
			</output>
		</YMDHMS>
		<YMDHMSS>
			<output>
				<pattern>MM-dd-yyyy HH:mm:ss.SSS</pattern>
			</output>
		</YMDHMSS>
		<Y2MD>
			<output>
				<pattern>MM-dd-yy</pattern>
			</output>
		</Y2MD>
		<Y2M>
			<output>
				<pattern>MM-yy</pattern>
			</output>
		</Y2M>
		<HM>
			<output>
				<pattern>HH:mm</pattern>
			</output>
		</HM>
		<Y2MDHM>
			<output>
				<pattern>MM-dd-yy HH:mm</pattern>
			</output>
		</Y2MDHM>
		<Y2MDHMS>
			<output>
				<pattern>MM-dd-yy HH:mm:ss</pattern>
			</output>
		</Y2MDHMS>
		<Y2MDHMSS>
			<output>
				<pattern>MM-dd-yy HH:mm:ss.SSS</pattern>
			</output>
		</Y2MDHMSS>
		<YMDE>
			<output>
				<pattern>E MM-dd-yyyy</pattern>
			</output>
		</YMDE>
		<Y2MDE>
			<output>
				<pattern>E MM-dd-yy</pattern>
			</output>
		</Y2MDE>
		<Y>
			<output>
				<pattern>yyyy</pattern>
			</output>
		</Y>
	</date>
	<excel>
		<EEE>aaa</EEE>
		<EEEE>aaaa</EEEE>
		<lcid>409</lcid>
	</excel>
</mcframe>
