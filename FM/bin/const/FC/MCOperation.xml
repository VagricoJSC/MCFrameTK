<?xml version="1.0" encoding="UTF-8"?>
<!--MCOperation Constant -->
<mcframe>
	<FC>
		<!-- ネイティブの設定はモジュールＩＤ単位、ロジックＩＤ単位、オペレーションＩＤ単位に設定できます。 「モジュールＩＤ単位＜ロジックＩＤ単位＜オペレーションＩＤ単位」の順に採用されます。 
			デフォルトはfalseです。 -->
		<native>false</native>
		<!-- invoke設定についてはmc-kernel-server/mcframe.serverCore.requester.MCInvokeTypeを参照のこと。 -->
		<FCBCL0000>
			<SessionKill>
				<invoke>2</invoke>
			</SessionKill>
		</FCBCL0000>
		<FCBHL0100>
			<Exec>
				<invoke>2</invoke>
			</Exec>
		</FCBHL0100>
		<FCBGL0020>
			<BinDl>
				<invoke>1</invoke>
			</BinDl>
			<FileDl>
				<invoke>1</invoke>
			</FileDl>
			<MCBinDl>
				<invoke>1</invoke>
			</MCBinDl>
		</FCBGL0020>
		<FCBGL1000>
			<GetCache>
				<invoke>3</invoke>
			</GetCache>
		</FCBGL1000>
		<FCBGL2000>
			<CallBufferPaging>
				<invoke>2</invoke>
			</CallBufferPaging>
			<CallPaging>
				<invoke>2</invoke>
			</CallPaging>
			<GetPage>
				<invoke>3</invoke>
			</GetPage>
		</FCBGL2000>
		<FCBGL4000>
			<CallAsync>
				<invoke>2</invoke>
			</CallAsync>
		</FCBGL4000>
		<FCBIL0000>
			<CallReport>
				<invoke>2</invoke>
			</CallReport>
			<PrintDataSearch>
				<invoke>2</invoke>
			</PrintDataSearch>
		</FCBIL0000>
		<FCBAL1000>
			<ListLogic>
				<invoke>1</invoke>
			</ListLogic>
			<Srch01>
				<invoke>1</invoke>
			</Srch01>
			<Srch02>
				<invoke>1</invoke>
			</Srch02>
            <Srch03>
                <listlogic>true</listlogic>
            </Srch03>
            <Srch04>
                <listlogic>true</listlogic>
            </Srch04>
		</FCBAL1000>
	</FC>
</mcframe>
