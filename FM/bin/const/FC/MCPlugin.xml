				<class>mcframe.clientCore.beans.dashboard.MCIconLabelGadget</class>
			</iconlabel>
			<mining>
				<class>mcframe.clientCore.beans.dashboard.MCMiningGadget</class>
			</mining>
		</gadget>
	</dashboard>
	<!-- Layouter (Client) -->
	<layout>
		<S>mcframe.clientCore.beans.layout.MCGeneralLayout</S>
	</layout>
	<!-- batch (Client) -->
	<batch>
		<controller>mcframe.clientCore.batch.MCBatchController</controller>
		<handler>mcframe.clientCore.batch.MCResourcedReturnCodeHandler</handler>
		<MCResourcedReturnCodeHandler>
			<map>
			</map>
		</MCResourcedReturnCodeHandler>
	</batch>
	<!-- PreloadJitResource(Client/Server) -->
	<preloadjitr>
		<client>
			<!-- 画面起動高速化設定をしたときにログインロケールのJITラベルリソースをロードするかどうか-->
			<!--MCDBLabel-->
			<dblbl><!-- moduleid.screenid=true --></dblbl>
			<!--MCLogicLabel-->
			<lgclbl><!-- moduleid.screenid=true --></lgclbl>
		</client>
		<server>
			<!-- サーバ側mcframe起動時に全ロケールのJITラベルリソースをロードするかどうか-->
			<!--MCDBLabel-->
			<dblbl>false</dblbl>
			<!--MCLogicLabel-->
			<lgclbl>false</lgclbl>
		</server>
	</preloadjitr>
	<!-- LogicPhase (Server)  -->
	<phase>
		<authorization>
			<name>core</name>
			<class>mcframe.serverCore.acl.MCACPhase</class>
		</authorization>
		<paraOpe>
			<name>core</name>
			<class>mcframe.serverCore.phase.MCInactivePhase</class>
		</paraOpe>
		<maxOpe>
			<name>core</name>
			<class>mcframe.serverCore.max.MCMaxVolCtrl</class>
		</maxOpe>
		<servSts>
			<name>core</name>
			<class>mcframe.serverCore.servSts.MCServStsCtrl</class>
		</servSts>
	</phase>
	<!-- LogicDispatch (Server)  -->
	<dispatcher>
		<logicInvoker>
			<name>core</name>
			<class>mcframe.serverCore.requester.MCLogicInvoker</class>
			<nativeClass>mcframe.serverCore.requester.MCNtvLogicInvoker</nativeClass>
		</logicInvoker>
	</dispatcher>
	<!-- Database (Server) -->
	<database>
		<site_module_id_sql>
			<FC></FC>
		</site_module_id_sql>
		<poolTraceLog>false</poolTraceLog>
		<wpa_log_version>2</wpa_log_version>
		<parser>2</parser>
		<!-- 6.3.1.0 add-s -->
		<purge>true</purge>
		<NoPurgeErr>
			<ORACLE>
				1,
				31,
				54,
				60,
				905,
				942,
				2291,
				2292,
				30006
			</ORACLE>
			<!--
			23505:一意制約違反
			23503:外部キー制約違反（親レコードがいない、子がいて消せない）
			40P01:deadlock_detected
			42601:syntax_error
			42P01:undefined_table
			55P03:lock_not_available
			-->
			<POSTGRESQL>
				23505,
				23503,
				40P01,
				42601,
				42P01,
				55P03
			</POSTGRESQL>
		</NoPurgeErr>
		<InvalidExCtrl>
			<!--
			Z.ZAL0100.Upd01,
			Z.ZAL0100.Upd02
			-->
		</InvalidExCtrl>
		<sqlErrCnv>
			<ORACLE>
				<FCBCC0110>54,30006</FCBCC0110>
				<FCBCC0136>1</FCBCC0136>
				<FCBCC0139>905</FCBCC0139>
				<FCBCC0140>942</FCBCC0140>
				<FCBCC0155>60</FCBCC0155>
			</ORACLE>
			<POSTGRESQL>
				<FCBCC0110>55P03</FCBCC0110>
				<FCBCC0136>23505</FCBCC0136>
				<FCBCC0139>42601</FCBCC0139>
				<FCBCC0140>42P01</FCBCC0140>
				<FCBCC0155>40P01</FCBCC0155>
			</POSTGRESQL>
		</sqlErrCnv>
		<!-- 6.3.1.0 add-e -->
		<continuesIfOnError_exclude>
			<FC>*WKINSERT,*WKDELETE</FC>
		</continuesIfOnError_exclude>
	</database>
	<!-- Authentication (Client/Server) -->
	<auth>
		<server>
			<ldap>
				<userconv>mcframe.serverCore.login.MCLDAPUserConverter</userconv>
			</ldap>
			<password>
				<policy></policy>
				<wstoken><!-- 7012-0881 -->
					<checker></checker>
					<pwchallenge>false</pwchallenge>
					<expire></expire><!-- for Default Checker -->
				</wstoken>
			</password>
			<extauth>
				<saml>
					<agent>mcframe.serverCore.login.MCSAMLAuthenticator</agent>
				</saml>
			</extauth>
		</server>
		<common>
			<hybrid>
				<userid>
					<analyzer>mcframe.commonCore.login.MCHybridUserIDAnalyzer</analyzer>
					<separator>@</separator>
					<userpos>0</userpos>
				</userid>
			</hybrid>
			<extauth>
				<saml>
					<PC>
						<sp>
							<url></url>
						</sp>
					</PC>
					<MD>
						<sp>
							<url></url>
						</sp>
					</MD>
				</saml>
			</extauth>
		</common>
		<client>
			<extauth>
				<saml>
					<class>mcframe.clientCore.login.MCGUISAMLAuthImpl</class>
					<attribute>
						<user_id>user_id</user_id>
					</attribute>
				</saml>
			</extauth>
		</client>
	</auth>
