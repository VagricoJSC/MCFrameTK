		<order></order>
	</message>
	<!-- LabelGetEvent (Client) -->
	<label>
		<order></order>
	</label>
	<!-- LoginEvent (Client) -->
	<login>
		<order></order>
		<FW_PUSH>mcframe.clientCore.push.MCServerPushListener</FW_PUSH>
	</login>
	<!-- LogoutEvent (Client) -->
	<logout>
		<order></order>
		<FW_PUSH>mcframe.clientCore.push.MCServerPushListener</FW_PUSH>
	</logout>
	<!-- StartupEvent (Client) -->
	<startup>
		<order></order>
	</startup>
	<!-- StatusBar (Client) -->
	<statusbar>
		<order></order>
	</statusbar>
	<!-- MessageBox (Client) -->
	<messagebox>
		<class>mcframe.clientCore.beans.MCMessageBox</class>
	</messagebox>
	<!-- Dashboard (Client) -->
	<dashboard>
		<gadget>
			<table>
				<class>mcframe.clientCore.beans.dashboard.MCTableGadget</class>
			</table>
			<chart>
				<class>mcframe.clientCore.beans.dashboard.MCFXChartGadget</class>
			</chart>
			<label>
				<class>mcframe.clientCore.beans.dashboard.MCLabelGadget</class>
			</label>
