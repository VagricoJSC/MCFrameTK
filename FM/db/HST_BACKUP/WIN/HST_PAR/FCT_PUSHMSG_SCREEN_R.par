INCLUDE=TABLE:"IN ('FCT_PUSHMSG_SCREEN_R','FCT_HST_HEADER')"
QUERY=FCT_PUSHMSG_SCREEN_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCT_PUSHMSG_SCREEN_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_PUSHMSG_SCREEN_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCT_PUSHMSG_SCREEN_R')))"

