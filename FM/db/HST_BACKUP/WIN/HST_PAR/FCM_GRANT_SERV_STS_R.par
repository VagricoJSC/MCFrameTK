INCLUDE=TABLE:"IN ('FCM_GRANT_SERV_STS_R','FCT_HST_HEADER')"
QUERY=FCM_GRANT_SERV_STS_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_GRANT_SERV_STS_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCM_GRANT_SERV_STS_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_GRANT_SERV_STS_R')))"

