INCLUDE=TABLE:"IN ('FCT_MINING_TASK_LOG_R','FCT_HST_HEADER')"
QUERY=FCT_MINING_TASK_LOG_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCT_MINING_TASK_LOG_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_MINING_TASK_LOG_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCT_MINING_TASK_LOG_R')))"

