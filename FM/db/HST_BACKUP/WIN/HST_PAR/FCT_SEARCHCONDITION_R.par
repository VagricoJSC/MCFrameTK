INCLUDE=TABLE:"IN ('FCT_SEARCHCONDITION_R','FCT_HST_HEADER')"
QUERY=FCT_SEARCHCONDITION_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCT_SEARCHCONDITION_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_SEARCHCONDITION_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCT_SEARCHCONDITION_R')))"

