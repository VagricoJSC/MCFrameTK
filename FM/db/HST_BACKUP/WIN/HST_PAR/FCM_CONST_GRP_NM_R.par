INCLUDE=TABLE:"IN ('FCM_CONST_GRP_NM_R','FCT_HST_HEADER')"
QUERY=FCM_CONST_GRP_NM_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_CONST_GRP_NM_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCM_CONST_GRP_NM_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_CONST_GRP_NM_R')))"

