INCLUDE=TABLE:"IN ('FCT_EXCLD_GRPS_R','FCT_HST_HEADER')"
QUERY=FCT_EXCLD_GRPS_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCT_EXCLD_GRPS_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_EXCLD_GRPS_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCT_EXCLD_GRPS_R')))"

