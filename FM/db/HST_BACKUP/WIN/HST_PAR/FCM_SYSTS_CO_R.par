INCLUDE=TABLE:"IN ('FCM_SYSTS_CO_R','FCT_HST_HEADER')"
QUERY=FCM_SYSTS_CO_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_SYSTS_CO_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCM_SYSTS_CO_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_SYSTS_CO_R')))"

