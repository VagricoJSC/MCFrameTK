INCLUDE=TABLE:"IN ('FCC_AVAIL_GP_BATCH_R','FCT_HST_HEADER')"
QUERY=FCC_AVAIL_GP_BATCH_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCC_AVAIL_GP_BATCH_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCC_AVAIL_GP_BATCH_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCC_AVAIL_GP_BATCH_R')))"

