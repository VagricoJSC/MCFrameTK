INCLUDE=TABLE:"IN ('FCM_ROLE_LCL_ALL_R','FCT_HST_HEADER')"
QUERY=FCM_ROLE_LCL_ALL_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_ROLE_LCL_ALL_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCM_ROLE_LCL_ALL_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_ROLE_LCL_ALL_R')))"

