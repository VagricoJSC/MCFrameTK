INCLUDE=TABLE:"IN ('FCM_MENU_ARGS_R','FCT_HST_HEADER')"
QUERY=FCM_MENU_ARGS_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_MENU_ARGS_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCM_MENU_ARGS_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_MENU_ARGS_R')))"

