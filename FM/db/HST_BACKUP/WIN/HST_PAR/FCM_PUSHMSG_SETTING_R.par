INCLUDE=TABLE:"IN ('FCM_PUSHMSG_SETTING_R','FCT_HST_HEADER')"
QUERY=FCM_PUSHMSG_SETTING_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_PUSHMSG_SETTING_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCM_PUSHMSG_SETTING_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_PUSHMSG_SETTING_R')))"

