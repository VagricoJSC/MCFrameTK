INCLUDE=TABLE:"IN ('FCM_EX_USER_MAP_R','FCT_HST_HEADER')"
QUERY=FCM_EX_USER_MAP_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_EX_USER_MAP_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCM_EX_USER_MAP_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_EX_USER_MAP_R')))"

