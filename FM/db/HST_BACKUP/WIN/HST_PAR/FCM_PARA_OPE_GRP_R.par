INCLUDE=TABLE:"IN ('FCM_PARA_OPE_GRP_R','FCT_HST_HEADER')"
QUERY=FCM_PARA_OPE_GRP_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_PARA_OPE_GRP_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCM_PARA_OPE_GRP_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCM_PARA_OPE_GRP_R')))"

