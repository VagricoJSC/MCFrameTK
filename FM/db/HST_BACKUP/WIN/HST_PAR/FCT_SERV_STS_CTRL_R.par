INCLUDE=TABLE:"IN ('FCT_SERV_STS_CTRL_R','FCT_HST_HEADER')"
QUERY=FCT_SERV_STS_CTRL_R:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCT_SERV_STS_CTRL_R'))"
QUERY=FCT_HST_HEADER:"WHERE HST_ID IN (SELECT HST_ID FROM FCT_SERV_STS_CTRL_R WHERE HST_ID IN (SELECT HST_ID FROM FCT_HST_HEADER  WHERE HST_TIME < FCPA_HISTORYBACKUP.F_HST_DUMP_TS('FCT_SERV_STS_CTRL_R')))"

