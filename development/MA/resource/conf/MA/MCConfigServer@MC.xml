<?xml version="1.0" encoding="UTF-8"?>
<!--MCFrame Environment Configuration-->
<mcframe>
<!-- 分割処理の設定 -->
<!-- 処理件数　　　：[モジュールＩＤ].[ロジックＩＤ].[オペレーションＩＤ].thread.batchSize -->
<!-- スレッド上限数：[モジュールＩＤ].[ロジックＩＤ].[オペレーションＩＤ].thread.limitSize -->
<thread>
	<batchSize>-1</batchSize>
	<limitSize>1</limitSize>
</thread>

<MA>
	<thread>
		<batchSize>{thread.batchSize}</batchSize>
		<limitSize>{thread.limitSize}</limitSize>
	</thread>
</MA>
</mcframe>
