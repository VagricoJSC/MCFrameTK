<?xml version="1.0" encoding="UTF-8"?>
<!--MCFrame Application Constant-->
<mcframe>
<include>_incConstNm@MC_A</include>
<MA>
	<biz_dat_dl>
		<replace_before_str>[\\\\/:*?"|&lt;&gt;]</replace_before_str>
		<replace_after_str>_</replace_after_str>
		<timestamp_format>yyyyMMddhhmmss</timestamp_format>
		<dwnld>
			<file_nm>{biz_dat_dl_nm}_{timestamp}</file_nm>
			<file_typ>xlsx</file_typ>
		</dwnld>
		<biz_screen>
			<file_nm>{screen_nm}_{timestamp}</file_nm>
			<file_typ>xlsx</file_typ>
		</biz_screen>
	</biz_dat_dl>
</MA>
</mcframe>
