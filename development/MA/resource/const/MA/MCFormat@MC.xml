<?xml version="1.0" encoding="UTF-8"?>
<!--MCFormat Constant-->
<mcframe>
	<number>
		<PERCENT_PADDING>
			<input>
				<pattern>#####0.##</pattern>
			</input>
			<output>
				<pattern>###,##0.##'%'</pattern>
			</output>
			<zero>PADDING</zero>
			<positive>
				<fg></fg>
			</positive>
			<negative>
				<fg>255,0,0</fg>
			</negative>
		</PERCENT_PADDING>
		<QN_INSP_VAL>
			<input>
				<pattern>#####0.##</pattern>
			</input>
			<output>
				<pattern>###,##0.##</pattern>
			</output>
			<zero>PADDING</zero>
			<positive>
				<fg></fg>
			</positive>
			<negative>
				<fg>255,0,0</fg>
			</negative>
		</QN_INSP_VAL>
	</number>
</mcframe>