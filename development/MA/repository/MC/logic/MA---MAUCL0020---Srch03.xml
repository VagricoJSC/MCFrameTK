<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<SPEC>
    <ID>MAUCL0020</ID>
    <COLUMN ID="MODULE_ID" TYPE="STRING">MA</COLUMN>
    <COLUMN ID="SUBMODULE_ID" TYPE="STRING">MAUC</COLUMN>
    <COLUMN ID="CLASS" TYPE="STRING">MAUCL_AppSys</COLUMN>
