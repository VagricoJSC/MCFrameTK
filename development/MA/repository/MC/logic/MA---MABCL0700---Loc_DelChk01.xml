<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<SPEC>
    <ID>MABCL0700</ID>
    <COLUMN ID="MODULE_ID" TYPE="STRING">MA</COLUMN>
    <COLUMN ID="SUBMODULE_ID" TYPE="STRING">MABC</COLUMN>
    <COLUMN ID="CLASS" TYPE="STRING">MABCL_LocReg</COLUMN>
    <COLUMN ID="NAME" TYPE="STRING">場所マスタ登録</COLUMN>
    <COLUMN ID="CLASS_SUFFIX" TYPE="STRING">MC</COLUMN>
    <COLUMN ID="SUPER_ID" TYPE="STRING">MA.MAUDL5010</COLUMN>
    <COLUMN ID="SUPER_CLASS" TYPE="STRING"/>
    <COLUMN ID="SUPER_CLASS_SUFFIX" TYPE="STRING"/>
    <COLUMN ID="GENE_TYPE" TYPE="STRING">ALL</COLUMN>
    <COLUMN ID="MEMO" TYPE="STRING">場所マスタ、場所補助マスタ、棚・ラインマスタ、場所マスタ(ロケール別情報)、棚・ラインマスタ(ロケール別情報)を削除する前のチェックを行う</COLUMN>
    <COLUMN ID="PACKAGE_FORM" TYPE="STRING"/>
    <COLUMN ID="MODIFIER" TYPE="STRING"/>
    <COLUMN ID="OPT1" TYPE="STRING"/>
    <COLUMN ID="IMPLE_INTERFACE" TYPE="STRING"/>
    <COLUMN ID="SUPER_INTERFACE" TYPE="STRING"/>
    <COLUMN ID="ACTYPE" TYPE="STRING"/>
    <COLUMN ID="GENE_DETAIL" TYPE="STRING"/>
    <COLUMN ID="METHOD_ID" TYPE="STRING">Loc_DelChk01</COLUMN>
    <COLUMN ID="METHOD" TYPE="STRING">Loc_DelChk01</COLUMN>
    <COLUMN ID="METHOD_NAME" TYPE="STRING">削除前チェック</COLUMN>
    <COLUMN ID="VERSION" TYPE="STRING">000000</COLUMN>
    <COLUMN ID="LOGIC_BODY" TYPE="STRING">MA.MAUDL5010.Checker</COLUMN>
    <COLUMN ID="PRIVATE" TYPE="STRING"/>
    <blocks>
        <BLOCK>
            <ID>Loc_DelChk01_Dtl</ID>
            <COLUMN ID="TYPE" TYPE="STRING">L</COLUMN>
            <COLUMN ID="DEPEND_TYPE" TYPE="STRING">$super$</COLUMN>
            <COLUMN ID="DEPEND" TYPE="STRING">DBC:MA.MAM_LOC</COLUMN>
            <COLUMN ID="MEMO" TYPE="STRING"/>
            <COLUMN ID="CLASS" TYPE="STRING">Loc_DelChk01_Dtl</COLUMN>
            <COLUMN ID="MODULE_ID" TYPE="STRING"/>
            <COLUMN ID="CLASS_SUFFIX" TYPE="STRING"/>
            <COLUMN ID="SUPER_CLASS_SUFFIX" TYPE="STRING"/>
            <COLUMN ID="SUPER_LIST_CLASS" TYPE="STRING">MCConstList</COLUMN>
            <COLUMN ID="SUPER_ROW_CLASS" TYPE="STRING">mcframe.serverMA.dbc.MAM_LOC_R</COLUMN>
            <COLUMN ID="MODIFIER" TYPE="STRING">public</COLUMN>
            <COLUMN ID="OPT1" TYPE="STRING"/>
            <COLUMN ID="GENE_MODE" TYPE="STRING">*</COLUMN>
            <COLUMN ID="GENE_MODE_LAYER" TYPE="NUMBER">2</COLUMN>
            <bNum>10</bNum>
            <items>
                <ITEM>
                    <ID>loc_cd</ID>
                    <COLUMN ID="KEY" TYPE="STRING"/>
                    <COLUMN ID="NAME" TYPE="STRING">Location cd.</COLUMN>
                    <COLUMN ID="MESSAGE" TYPE="STRING">場所ＣＤ</COLUMN>
                    <COLUMN ID="MESSAGE_CTL" TYPE="STRING"/>
                    <COLUMN ID="TYPE" TYPE="STRING">#MA.LOC_CD</COLUMN>
                    <COLUMN ID="DIGIT" TYPE="STRING"/>
                    <COLUMN ID="MEMO" TYPE="STRING"/>
                    <COLUMN ID="_LENGTH" TYPE="NUMBER"/>
                    <COLUMN ID="_DECIMAL" TYPE="NUMBER"/>
                    <COLUMN ID="_MINUS" TYPE="BOOLEAN">false</COLUMN>
                    <COLUMN ID="CP_ALIAS" TYPE="STRING"/>
                </ITEM>
                <ITEM>
                    <ID>upd_cntr</ID>
                    <COLUMN ID="KEY" TYPE="STRING"/>
                    <COLUMN ID="NAME" TYPE="STRING">Update counter</COLUMN>
                    <COLUMN ID="MESSAGE" TYPE="STRING">更新カウンタ</COLUMN>
                    <COLUMN ID="MESSAGE_CTL" TYPE="STRING"/>
                    <COLUMN ID="TYPE" TYPE="STRING">#MA.UPD_CNT</COLUMN>
                    <COLUMN ID="DIGIT" TYPE="STRING"/>
                    <COLUMN ID="MEMO" TYPE="STRING"/>
                    <COLUMN ID="_LENGTH" TYPE="NUMBER"/>
                    <COLUMN ID="_DECIMAL" TYPE="NUMBER"/>
                    <COLUMN ID="_MINUS" TYPE="BOOLEAN">false</COLUMN>
                    <COLUMN ID="CP_ALIAS" TYPE="STRING"/>
                </ITEM>
            </items>
        </BLOCK>
    </blocks>
    <vSpecs>
        <GROUP CODE="U">
            <SPEC>
                <ID>MA.MABCL0700.Loc_DelChk01</ID>
                <COLUMN ID="CODE" TYPE="STRING">U</COLUMN>
                <COLUMN ID="CLASS" TYPE="STRING"/>
                <COLUMN ID="VERSION" TYPE="STRING">000000</COLUMN>
                <blocks>
                    <BLOCK>
                        <ID>Loc_DelChk01_Dtl</ID>
                        <COLUMN ID="UP_CODE" TYPE="STRING"/>
                        <COLUMN ID="DOWN_CODE" TYPE="STRING"/>
                        <items>
                            <ITEM>
                                <ID>loc_cd</ID>
                                <COLUMN ID="UP_CODE" TYPE="STRING">E</COLUMN>
                                <COLUMN ID="DOWN_CODE" TYPE="STRING">-</COLUMN>
                            </ITEM>
                            <ITEM>
                                <ID>upd_cntr</ID>
                                <COLUMN ID="UP_CODE" TYPE="STRING">E</COLUMN>
                                <COLUMN ID="DOWN_CODE" TYPE="STRING">-</COLUMN>
                            </ITEM>
                        </items>
                    </BLOCK>
                </blocks>
            </SPEC>
        </GROUP>
        <GROUP CODE="K">
            <SPEC>
                <ID>REQUIRED</ID>
                <COLUMN ID="CODE" TYPE="STRING">K</COLUMN>
                <COLUMN ID="CLASS" TYPE="STRING"/>
                <blocks>
                    <BLOCK>
                        <ID>Loc_DelChk01_Dtl</ID>
                        <COLUMN ID="CODE" TYPE="STRING"/>
                        <items>
                            <ITEM>
                                <ID>loc_cd</ID>
                                <COLUMN ID="CODE" TYPE="STRING">E</COLUMN>
                            </ITEM>
                            <ITEM>
                                <ID>upd_cntr</ID>
                                <COLUMN ID="CODE" TYPE="STRING"/>
                            </ITEM>
                        </items>
                    </BLOCK>
                </blocks>
            </SPEC>
        </GROUP>
        <GROUP CODE="o"/>
    </vSpecs>
</SPEC>
