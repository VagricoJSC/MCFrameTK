<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<SPEC>
    <ID>MAUDL6010</ID>
    <COLUMN ID="MODULE_ID" TYPE="STRING">MA</COLUMN>
    <COLUMN ID="SUBMODULE_ID" TYPE="STRING">MAUD</COLUMN>
    <COLUMN ID="CLASS" TYPE="STRING">MAUDL_RLUtil</COLUMN>
    <COLUMN ID="NAME" TYPE="STRING">マスタ（見出し一覧）ユーティリティ</COLUMN>
    <COLUMN ID="CLASS_SUFFIX" TYPE="STRING">MC</COLUMN>
    <COLUMN ID="SUPER_ID" TYPE="STRING">$def$</COLUMN>
    <COLUMN ID="SUPER_CLASS" TYPE="STRING"/>
    <COLUMN ID="SUPER_CLASS_SUFFIX" TYPE="STRING"/>
    <COLUMN ID="GENE_TYPE" TYPE="STRING">ALL</COLUMN>
    <COLUMN ID="MEMO" TYPE="STRING">MAM_MST_CTL(マスタ制御情報).マスタ設定区分の取得</COLUMN>
    <COLUMN ID="PACKAGE_FORM" TYPE="STRING"/>
    <COLUMN ID="MODIFIER" TYPE="STRING"/>
    <COLUMN ID="OPT1" TYPE="STRING"/>
    <COLUMN ID="IMPLE_INTERFACE" TYPE="STRING"/>
    <COLUMN ID="SUPER_INTERFACE" TYPE="STRING"/>
    <COLUMN ID="ACTYPE" TYPE="STRING"/>
    <COLUMN ID="GENE_DETAIL" TYPE="STRING"/>
    <COLUMN ID="METHOD_ID" TYPE="STRING">Srch01</COLUMN>
    <COLUMN ID="METHOD" TYPE="STRING">Srch01</COLUMN>
    <COLUMN ID="METHOD_NAME" TYPE="STRING">マスタ設定区分</COLUMN>
    <COLUMN ID="VERSION" TYPE="STRING">000000</COLUMN>
    <COLUMN ID="LOGIC_BODY" TYPE="STRING">$def$</COLUMN>
    <COLUMN ID="PRIVATE" TYPE="STRING"/>
    <blocks>
        <BLOCK>
            <ID>Srch01_Cnd</ID>
            <COLUMN ID="TYPE" TYPE="STRING">R</COLUMN>
            <COLUMN ID="DEPEND_TYPE" TYPE="STRING"/>
            <COLUMN ID="DEPEND" TYPE="STRING"/>
            <COLUMN ID="MEMO" TYPE="STRING"/>
            <COLUMN ID="CLASS" TYPE="STRING">Srch01_Cnd</COLUMN>
            <COLUMN ID="MODULE_ID" TYPE="STRING"/>
            <COLUMN ID="CLASS_SUFFIX" TYPE="STRING"/>
            <COLUMN ID="SUPER_CLASS_SUFFIX" TYPE="STRING"/>
            <COLUMN ID="SUPER_LIST_CLASS" TYPE="STRING">MCConstList</COLUMN>
            <COLUMN ID="SUPER_ROW_CLASS" TYPE="STRING">MCConstRow</COLUMN>
            <COLUMN ID="MODIFIER" TYPE="STRING">public</COLUMN>
            <COLUMN ID="OPT1" TYPE="STRING"/>
            <COLUMN ID="GENE_MODE" TYPE="STRING">*</COLUMN>
            <COLUMN ID="GENE_MODE_LAYER" TYPE="NUMBER">2</COLUMN>
            <bNum>10</bNum>
            <items>
                <ITEM>
                    <ID>mst_nm</ID>
                    <COLUMN ID="KEY" TYPE="STRING"/>
                    <COLUMN ID="NAME" TYPE="STRING">Master name</COLUMN>
                    <COLUMN ID="MESSAGE" TYPE="STRING">マスタ名</COLUMN>
                    <COLUMN ID="MESSAGE_CTL" TYPE="STRING"/>
                    <COLUMN ID="TYPE" TYPE="STRING">#MA.ORA_OBJ_NM</COLUMN>
                    <COLUMN ID="DIGIT" TYPE="STRING"/>
                    <COLUMN ID="MEMO" TYPE="STRING"/>
                    <COLUMN ID="_LENGTH" TYPE="NUMBER"/>
                    <COLUMN ID="_DECIMAL" TYPE="NUMBER"/>
                    <COLUMN ID="_MINUS" TYPE="BOOLEAN">false</COLUMN>
                    <COLUMN ID="CP_ALIAS" TYPE="STRING"/>
                </ITEM>
            </items>
        </BLOCK>
        <BLOCK>
            <ID>Srch01_Rslt</ID>
            <COLUMN ID="TYPE" TYPE="STRING">R</COLUMN>
            <COLUMN ID="DEPEND_TYPE" TYPE="STRING"/>
            <COLUMN ID="DEPEND" TYPE="STRING"/>
            <COLUMN ID="MEMO" TYPE="STRING"/>
            <COLUMN ID="CLASS" TYPE="STRING">Srch01_Rslt</COLUMN>
            <COLUMN ID="MODULE_ID" TYPE="STRING"/>
            <COLUMN ID="CLASS_SUFFIX" TYPE="STRING"/>
            <COLUMN ID="SUPER_CLASS_SUFFIX" TYPE="STRING"/>
            <COLUMN ID="SUPER_LIST_CLASS" TYPE="STRING">MCConstList</COLUMN>
            <COLUMN ID="SUPER_ROW_CLASS" TYPE="STRING">MCConstRow</COLUMN>
            <COLUMN ID="MODIFIER" TYPE="STRING">public</COLUMN>
            <COLUMN ID="OPT1" TYPE="STRING"/>
            <COLUMN ID="GENE_MODE" TYPE="STRING">*</COLUMN>
            <COLUMN ID="GENE_MODE_LAYER" TYPE="NUMBER">2</COLUMN>
            <bNum>20</bNum>
            <items>
                <ITEM>
                    <ID>mst_set_typ</ID>
                    <COLUMN ID="KEY" TYPE="STRING"/>
                    <COLUMN ID="NAME" TYPE="STRING">Master setting type</COLUMN>
                    <COLUMN ID="MESSAGE" TYPE="STRING">マスタ設定区分</COLUMN>
                    <COLUMN ID="MESSAGE_CTL" TYPE="STRING"/>
                    <COLUMN ID="TYPE" TYPE="STRING">#MA.MST_SET_TYP</COLUMN>
                    <COLUMN ID="DIGIT" TYPE="STRING"/>
                    <COLUMN ID="MEMO" TYPE="STRING"/>
                    <COLUMN ID="_LENGTH" TYPE="NUMBER"/>
                    <COLUMN ID="_DECIMAL" TYPE="NUMBER"/>
                    <COLUMN ID="_MINUS" TYPE="BOOLEAN">false</COLUMN>
                    <COLUMN ID="CP_ALIAS" TYPE="STRING"/>
                </ITEM>
                <ITEM>
                    <ID>mst_set_typ_nm</ID>
                    <COLUMN ID="KEY" TYPE="STRING"/>
                    <COLUMN ID="NAME" TYPE="STRING">Master setting type name</COLUMN>
                    <COLUMN ID="MESSAGE" TYPE="STRING">マスタ設定区分名</COLUMN>
                    <COLUMN ID="MESSAGE_CTL" TYPE="STRING"/>
                    <COLUMN ID="TYPE" TYPE="STRING">#MA.MST_SET_TYP_NM</COLUMN>
                    <COLUMN ID="DIGIT" TYPE="STRING"/>
                    <COLUMN ID="MEMO" TYPE="STRING"/>
                    <COLUMN ID="_LENGTH" TYPE="NUMBER"/>
                    <COLUMN ID="_DECIMAL" TYPE="NUMBER"/>
                    <COLUMN ID="_MINUS" TYPE="BOOLEAN">false</COLUMN>
                    <COLUMN ID="CP_ALIAS" TYPE="STRING"/>
                </ITEM>
            </items>
        </BLOCK>
    </blocks>
    <vSpecs>
        <GROUP CODE="U">
            <SPEC>
                <ID>MA.MAUDL6010.Srch01</ID>
                <COLUMN ID="CODE" TYPE="STRING">U</COLUMN>
                <COLUMN ID="CLASS" TYPE="STRING"/>
                <COLUMN ID="VERSION" TYPE="STRING">000000</COLUMN>
                <blocks>
                    <BLOCK>
                        <ID>Srch01_Cnd</ID>
                        <COLUMN ID="UP_CODE" TYPE="STRING"/>
                        <COLUMN ID="DOWN_CODE" TYPE="STRING"/>
                        <items>
                            <ITEM>
                                <ID>mst_nm</ID>
                                <COLUMN ID="UP_CODE" TYPE="STRING">E</COLUMN>
                                <COLUMN ID="DOWN_CODE" TYPE="STRING">-</COLUMN>
                            </ITEM>
                        </items>
                    </BLOCK>
                    <BLOCK>
                        <ID>Srch01_Rslt</ID>
                        <COLUMN ID="UP_CODE" TYPE="STRING"/>
                        <COLUMN ID="DOWN_CODE" TYPE="STRING"/>
                        <items>
                            <ITEM>
                                <ID>mst_set_typ</ID>
                                <COLUMN ID="UP_CODE" TYPE="STRING">-</COLUMN>
                                <COLUMN ID="DOWN_CODE" TYPE="STRING">E</COLUMN>
                            </ITEM>
                            <ITEM>
                                <ID>mst_set_typ_nm</ID>
                                <COLUMN ID="UP_CODE" TYPE="STRING">-</COLUMN>
                                <COLUMN ID="DOWN_CODE" TYPE="STRING">E</COLUMN>
                            </ITEM>
                        </items>
                    </BLOCK>
                </blocks>
            </SPEC>
        </GROUP>
        <GROUP CODE="o"/>
    </vSpecs>
</SPEC>
