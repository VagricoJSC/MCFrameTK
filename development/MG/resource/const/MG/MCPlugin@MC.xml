<?xml version="1.0" encoding="UTF-8"?>
<!--MCPlugin Constant-->
<mcframe>
	<!-- Report ID -->
	<report>
		<register>
			<MGBFR0010>true</MGBFR0010>
			<MGBFR0020>true</MGBFR0020>
		</register>
	</report>
	<requester>
		<status>
			<!-- 「MGBDB0010」のCalcCost_Upd01オペレーションを保存対象とする -->
			<MGBD01>
				<!-- ID指定設定の優先順（指定していない場合は優先度低とみなす） -->
				<order>10</order>
				<!-- パターンはカンマ区切りで複数指定可能 -->
				<ptn>MG.MGBDB0010.CalcCost_Upd01*</ptn>
				<register>true</register>
			</MGBD01>
		</status>
	</requester>

</mcframe>
