		</MBBEL0040>
		<MBBEL0090>
			<trimWith>
				<default>BOTH</default>
				<target>
					<MA>
						<MABCL0300>
							<Hs_Upd01>
								<hs_nm>NONE</hs_nm>
							</Hs_Upd01>
							<HsLcl_Upd01>
								<hs_nm>NONE</hs_nm>
							</HsLcl_Upd01>
						</MABCL0300>
						<MABCL0490>
							<PoPrint_Upd01>
								<txt_new_off>NONE</txt_new_off>
								<txt_mod_off>NONE</txt_mod_off>
								<txt_del_off>NONE</txt_del_off>
								<txt_new_on>NONE</txt_new_on>
								<txt_mod_on>NONE</txt_mod_on>
