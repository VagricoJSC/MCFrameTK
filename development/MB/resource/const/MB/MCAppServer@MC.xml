					<MA>
						<MABCL0300>
							<Hs_Upd01>
								<hs_nm>
									<before>
									</before>
								</hs_nm>
							</Hs_Upd01>
							<HsLcl_Upd01>
								<hs_nm><before></before></hs_nm>
							</HsLcl_Upd01>
						</MABCL0300>
						<MABCL0490>
							<PoPrint_Upd01>
								<txt_new_off>
									<before>
									</before>
								</txt_new_off>
								<txt_mod_off>
									<before>
									</before>
								</txt_mod_off>
								<txt_del_off>
									<before>
									</before>
								</txt_del_off>
								<txt_new_on>
									<before>
									</before>
								</txt_new_on>
								<txt_mod_on>
									<before>
									</before>
								</txt_mod_on>
								<txt_del_on>
									<before>
									</before>
								</txt_del_on>
							</PoPrint_Upd01>
						</MABCL0490>
						<MABSL0770>
							<ItmVer_Upd01>
								<itm_ver_vld_rmrks><before></before></itm_ver_vld_rmrks>
							</ItmVer_Upd01>
						</MABSL0770>
					</MA>
				</target>
			</replaceWith>
